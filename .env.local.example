# Vorlage für .env.local — echte Werte gehören NICHT ins Repository.
# Kopieren mit:  cp .env.local.example .env.local
# .env*.local ist in .gitignore ausgenommen.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key
# Umgeht Row Level Security — ausschließlich serverseitig verwenden
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# ── Anwendung ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Beta-Modus: alle Nutzer erhalten Premium-Zugriff
NEXT_PUBLIC_BETA_MODE=true
NEXT_PUBLIC_MVP_MODE=true

# ── Stripe (Freemium, PROJ-8) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_dein-key
STRIPE_WEBHOOK_SECRET=whsec_dein-secret
STRIPE_PRICE_MONTHLY=price_dein-monatspreis
STRIPE_PRICE_YEARLY=price_dein-jahrespreis

# ── E-Mail (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_dein-key
CONTACT_EMAIL_TO=kontakt@deine-domain.de

# ── Push-Benachrichtigungen (PROJ-23) ────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=dein-vapid-public-key
VAPID_PRIVATE_KEY=dein-vapid-private-key

# ── Ersatzteil-Suche (PROJ-9) ────────────────────────────────────────────────
SERPAPI_API_KEY=dein-serpapi-key

# ── Cron-Jobs (Vercel) ───────────────────────────────────────────────────────
CRON_SECRET=dein-cron-secret

# ── E2E-Tests (optional) ─────────────────────────────────────────────────────
# Zugangsdaten eines Testnutzers für die angemeldeten Playwright-Tests.
# Ohne diese Werte werden die *-auth.spec.ts-Tests übersprungen; die
# unangemeldeten Tests laufen unverändert.
#
# ACHTUNG: Es gibt keine getrennte Testdatenbank. Die angemeldeten Tests
# laufen gegen dieselbe Datenbank wie die Anwendung. Sie sind deshalb rein
# lesend gehalten — lege hier trotzdem besser einen eigenen Testnutzer an
# statt eines echten Kontos.
E2E_EMAIL=test@deine-domain.de
E2E_PASSWORD=dein-testpasswort
